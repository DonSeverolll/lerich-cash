rules_version = '2';

// Lerich Finance — o aplicativo acessa o Firestore SOMENTE pelo servidor, com
// credencial de service account (Admin SDK), que passa por cima destas regras.
// Portanto, o acesso direto do navegador deve ser negado por completo: se
// alguma regra permitisse leitura, os hashes de senha e a trilha de auditoria
// ficariam expostos a qualquer visitante.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
