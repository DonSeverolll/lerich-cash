# ------------------------------------------------------------------
# Autenticação (obrigatório)
# ------------------------------------------------------------------
# Chave que assina o cookie de sessão (HMAC-SHA256). Mínimo de 32 caracteres.
# Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Administrador criado no primeiro boot. Sem estas duas variáveis nenhum
# administrador é criado — o sistema NUNCA traz um acesso padrão embutido.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_EMAIL=

# Cliente de demonstração (opcional). Só é criado se você definir a senha.
# Deixe em branco em produção.
DEMO_PASSWORD=

# ------------------------------------------------------------------
# Supabase (opcional — dados financeiros)
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
