# ------------------------------------------------------------------
# Autenticação (obrigatório)
# ------------------------------------------------------------------
# Chave que assina o cookie de sessão (HMAC-SHA256). Mínimo de 32 caracteres.
# Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Administrador criado no primeiro boot. Sem estas duas variáveis nenhum
# administrador é criado — o sistema NUNCA traz um acesso padrão embutido.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_EMAIL=

# Cliente de demonstração (opcional). Só é criado se você definir a senha.
# Deixe em branco em produção.
DEMO_PASSWORD=

# ------------------------------------------------------------------
# E-mail transacional (recuperação de senha)
# ------------------------------------------------------------------
# Sem RESEND_API_KEY nenhum e-mail sai: o link é gravado no log do servidor,
# o que mantém o fluxo testável em desenvolvimento.
# Crie a chave em https://resend.com/api-keys
RESEND_API_KEY=

# Remetente. Duas situações:
#   1) Sem domínio próprio — use "Lerich Finance <onboarding@resend.dev>".
#      Atenção: esse remetente é compartilhado e o Resend SÓ entrega para o
#      e-mail dono da conta. Serve para testar; nenhum cliente recebe.
#   2) Com domínio verificado em https://resend.com/domains — use um endereço
#      dele: "Lerich Finance <nao-responda@seudominio.com>". Aí vale para todos.
# Confira o estado com: npm run mail:check
MAIL_FROM=

# URL pública usada nos links do e-mail.
#   · Local: o endereço do seu dev server (ex.: http://localhost:3000).
#   · Vercel: pode deixar em branco — o domínio de produção é detectado
#     automaticamente. Só preencha se usar domínio próprio ou um proxy na frente.
APP_URL=

# ------------------------------------------------------------------
# Firebase / Cloud Firestore (persistência dos dados de acesso)
# ------------------------------------------------------------------
# Com estas variáveis preenchidas o sistema usa o Firestore automaticamente.
# Sem elas, cai no arquivo local .data/store.json — que NÃO persiste na Vercel.
#
# Os valores saem do arquivo JSON baixado em:
#   Console do Firebase → Configurações do projeto → Contas de serviço
#   → Gerar nova chave privada
#
# Confira a configuração com:  npm run firebase:check
#
# NUNCA use o prefixo NEXT_PUBLIC_ aqui: esta credencial é de servidor e dá
# acesso total ao banco.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# A chave inteira em uma linha, com os \n literais, entre aspas:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# Alternativa às três acima: o JSON inteiro do service account, em texto ou
# base64. Útil em painéis que não lidam bem com quebras de linha.
FIREBASE_SERVICE_ACCOUNT=
