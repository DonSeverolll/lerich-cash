# ------------------------------------------------------------------
# Autenticação (obrigatório)
# ------------------------------------------------------------------
# Chave que assina o cookie de sessão (HMAC-SHA256). Mínimo de 32 caracteres.
# Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Administrador criado no primeiro boot. Sem estas duas variáveis nenhum
# administrador é criado — o sistema NUNCA traz um acesso padrão embutido.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_EMAIL=

# Cliente de demonstração (opcional). Só é criado se você definir a senha.
# Deixe em branco em produção.
DEMO_PASSWORD=

# ------------------------------------------------------------------
# E-mail transacional (recuperação de senha)
# ------------------------------------------------------------------
# Sem RESEND_API_KEY nenhum e-mail sai: o link é gravado no log do servidor,
# o que mantém o fluxo testável em desenvolvimento.
# Crie a chave em https://resend.com/api-keys
RESEND_API_KEY=
# Remetente verificado no provedor. Ex.: "Lerich Finance <nao-responda@seudominio.com>"
MAIL_FROM=
# URL pública usada nos links do e-mail. Na Vercel é detectada automaticamente.
APP_URL=

# ------------------------------------------------------------------
# Supabase (opcional — dados financeiros)
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
